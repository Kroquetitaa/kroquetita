{
  "name": "kroquetita",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets:city": "node scripts/prepare-city-assets.mjs",
    "check:city": "node --experimental-strip-types scripts/check-city-integration.mjs",
    "check:portals": "node --experimental-strip-types scripts/check-portals.mjs && node --experimental-strip-types scripts/check-portal-launch.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@netlify/blobs": "^11.1.9",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
